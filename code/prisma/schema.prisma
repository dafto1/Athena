// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client { 
  provider = "prisma-client" 
  output = "../app/generated/prisma" 
} 

datasource db{ 
  provider = "postgresql" 
  
}
enum TaskPriority{
  LOW 
  MEDIUM 
  HIGH 
} 

model User { 
  id String @id @default(cuid())  
  name String? 
  email String @unique 
  passwordHash String 
  createdAt DateTime @default(now()) 
  tasks Task[]  
  studySessions StudySession[]
  resources Resource[]
  annotations Annotation[]
  createdGroups StudyGroup[] @relation("CreatedGroups")
  groupMemberships StudyGroupMember[]
  sharedResources GroupResource[]
 }

 model Task { 
  id String @id @default(cuid())  
  title String 
  description String? 
  dueDate DateTime? 
  priority TaskPriority @default(MEDIUM) 
  completed Boolean @default(false) 
  completedAt DateTime? 
  createdAt DateTime @default(now())  
  updatedAt DateTime @updatedAt 
  userId String 
  user User @relation(fields : [userId] , references : [id] , onDelete : Cascade) 
  @@index([userId , completed ,dueDate]) 
} 

model StudySession { 
  id String @id @default(cuid()) 
  durationMin Int 
  startedAt DateTime 
  completedAt DateTime @default(now())
  userId String 
  user User @relation(fields : [userId] , references: [id] , onDelete : Cascade) 
  @@index([userId, completedAt])
}

model Resource {
  id String @id @default(cuid())
  title String
  fileName String
  fileType String
  fileSize Int
  fileData Bytes
  category String @default("General")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  annotations Annotation[]
  groupShares GroupResource[]

  @@index([userId, category])
}

enum AnnotationType {
  HIGHLIGHT
  NOTE
}

model Annotation {
  id         String         @id @default(cuid())
  type       AnnotationType
  pageNumber Int
  content    String?
  color      String         @default("#facc15")
  xPct       Float
  yPct       Float
  wPct       Float          @default(0)
  hPct       Float          @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  resourceId String
  resource   Resource       @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resourceId, userId, pageNumber])
}

enum GroupRole {
  ADMIN
  MEMBER
}

model StudyGroup {
  id          String             @id @default(cuid())
  name        String
  description String?
  inviteCode  String             @unique
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  createdBy   User               @relation("CreatedGroups", fields: [createdById], references: [id], onDelete: Cascade)
  members     StudyGroupMember[]
  folders     StudyGroupFolder[]
  resources   GroupResource[]

  @@index([createdById])
  @@index([inviteCode])
}

model StudyGroupMember {
  id       String     @id @default(cuid())
  groupId  String
  userId   String
  role     GroupRole  @default(MEMBER)
  joinedAt DateTime   @default(now())
  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

model StudyGroupFolder {
  id        String          @id @default(cuid())
  name      String
  groupId   String
  createdAt DateTime        @default(now())
  group     StudyGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  resources GroupResource[]

  @@unique([groupId, name])
  @@index([groupId])
}

model GroupResource {
  id         String            @id @default(cuid())
  groupId    String
  resourceId String
  sharedById String
  folderId   String?
  createdAt  DateTime          @default(now())
  group      StudyGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  resource   Resource          @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  sharedBy   User              @relation(fields: [sharedById], references: [id], onDelete: Cascade)
  folder     StudyGroupFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([groupId, resourceId])
  @@index([groupId])
  @@index([resourceId])
  @@index([sharedById])
}